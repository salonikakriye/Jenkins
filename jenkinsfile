pipeline {
    agent {
        label "worker"
    }

    tools {
        maven "maven"
    }

    stages {
        stage('checkout'){
            steps{
                git 'https://github.com/salonikakriye/Jenkins.git'
                sh '''
                echo "clonning is successful"
                '''
            }
        }

        stage('Build'){
            steps {
                sh '''
                mvn clean package
                echo "build is successful"
                '''
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        // stage('Artifact to s3') {
        //     steps {
        //         sh '''
        //         aws s3 cp target/*.war s3://deploywithsaloni.space/Artifact/student.war
        //         '''
        //     }
        // }

        stage('SonarQube Analysis'){
            steps{
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
    }
}